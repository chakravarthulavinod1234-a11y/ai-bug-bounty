# BountyPilot AI provider configuration
# The current CLI uses the deterministic local planner and does not make LLM calls.
# These names are reserved for a future provider adapter; never commit a real key.
BOUNTYPILOT_LLM_PROVIDER=none
BOUNTYPILOT_LLM_API_KEY=
BOUNTYPILOT_LLM_MODEL=

# Local state location is currently configured by the application default.
# BOUNTYPILOT_DATA_DIR=.bountypilot
